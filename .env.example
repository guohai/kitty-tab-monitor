# Copy to .env (same folder as config.json). Real shell env vars override these.
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
# Required only when kitty.conf uses: allow_remote_control password
# KITTY_RC_PASSWORD=your-kitty-remote-control-password
# Optional overrides:
# KTM_MODEL=gpt-4o-mini
# KTM_DRY_RUN=1
